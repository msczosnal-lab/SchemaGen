<?xml version="1.0" encoding="utf-8"?>
<!--
  SchemaGen — reguły numeracji DT urządzeń (per identyfikator).
  Sesja 1.7f. Kontrakt PER PROJEKT — docelowo generowany przez LLM / aplikację,
  nie hardkodowany w kodzie.

  Atrybuty <rule>:
    identifier   — identyfikator DT (np. FC, MA, KA). Bez znaku '-'.
    scope        — INTENCJA liczenia (dokumentacja + przyszła logika):
                     perLocation  = licznik resetowany per lokalizacja (np. +B2-FC1, +B4-FC1)
                     projectWide  = licznik globalny w całym projekcie (np. +B2-MA1, +B4-MA2)
    configScheme — DOKŁADNA nazwa schematu numeracji z EPLAN
                   (Ustawienia → Projekty → <projekt> → Urządzenia → Numeracja offline).
                   Pusty ("") = domyślny schemat projektu (zwykle per-lokalizacja).
                   To ten parametr realnie ustawia zakres liczenia w EPLAN —
                   /IDENTIFIER tylko filtruje, które DT renumerować w danym przebiegu.
    startValue   — wartość początkowa licznika (rezerwa pod przyszłe wpięcie do akcji).
    step         — krok licznika (rezerwa j.w.).

  Kolejność <rule> = kolejność przebiegów renumber (dual-pass).
  <fallback> — gdy DT nie pasuje do żadnej reguły.

  Dostępne schematy numeracji w EPLAN (1.7f, do wyboru jako configScheme):
    - "Identyfikator + Licznik / Akcesoria techniki strumieniowej"
        identyfikator + licznik co KOLUMNĘ (globalny), zachowuje prefiks i litery licznika
    - "Identyfikator + Licznik techniki strumieniowej"
        identyfikator + licznik co KOLUMNĘ (GLOBALNY), zachowuje prefiks  ← MA (globalne MA1, MA2)
    - "Identyfikator licznik"
        identyfikator + licznik co STRONĘ (resetuje per strona)
    - "Klucz mediów"
        klucz mediów + nr obwodu (prefiks) + licznik co kolumnę

  Tokeny formatu (gdyby tworzyć własny schemat):
    Identyfikator [<1...,0>] | Strona S | Kolumna P | Cc=licznik kolumnami (globalny)
    | Cl=licznik wierszami | Sc/Sl=Strona+licznik (per strona) | Separator SP | Wiersz R
  GLOBALNY licznik = [Identyfikator][Cc] (bez Strona/Sc). PER-STRONA = z tokenem Strona/Sc.
  PER-LOKALIZACJA = schemat domyślny projektu (configScheme="").

  Kontrakt PER PROJEKT — docelowo generowany przez LLM/aplikację, nie hardkodowany.
  [RYZYKO] nazwy schematów i param /CONFIGSCHEME potwierdza probe SchemaGen_TryRenumber_MA.cs.
-->
<NumberingRules schemaVersion="1">
  <rule identifier="FC" scope="perLocation"  configScheme="" startValue="1" step="1"
        comment="Falowniki — schemat domyślny (per lokalizacja): +MAIN-FC1, +MAIN-FC2 — zostaje" />
  <rule identifier="MA" scope="projectWide" configScheme="Identyfikator + Licznik techniki strumieniowej" startValue="1" step="1"
        comment="Silniki — globalny licznik co kolumnę: +B2-MA1, +B4-MA2 (ignoruje lokalizację)" />
  <fallback scope="perLocation" configScheme="" />
</NumberingRules>
